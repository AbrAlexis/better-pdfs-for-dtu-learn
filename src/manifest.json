{
  "manifest_version": 3,
  "name": "DTU PDF Search",
  "version": "0.2.0",
  "description": "Search every page of a PDF directly inside DTU Learn.",
  "content_scripts": [{
    "matches": ["https://learn.inside.dtu.dk/*"],
    "js": ["content.js"],
    "run_at": "document_idle",
    "all_frames": true
  }],
  "web_accessible_resources": [{
    "resources": ["viewer.html"],
    "matches": ["https://learn.inside.dtu.dk/*"]
  }],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'none'; connect-src 'self';"
  }
}
