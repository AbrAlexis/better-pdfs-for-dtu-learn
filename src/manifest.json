{
  "manifest_version": 3,
  "name": "Better PDFs for DTU Learn",
  "version": "0.2.0",
  "description": "Improves PDFs on DTU Learn with full-document search, zoom, printing, downloads, and flexible viewing options.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [{
    "matches": ["https://learn.inside.dtu.dk/*"],
    "js": ["content.js"],
    "run_at": "document_idle",
    "all_frames": true
  }],
  "web_accessible_resources": [{
    "resources": ["viewer.html"],
    "matches": ["https://learn.inside.dtu.dk/*"]
  }],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'none'; connect-src 'self';"
  }
}
